<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Random</title>
</head>
<body>
    <h3>Random Number: <%= Math.floor(Math.random() * 42) + 1 %></h3>
    <h3>Random Number from index.js: <%= rand %></h3>
    <!-- <%  %> for javascript -->
    <% if(rand % 2 === 0) { %>
        <h3>The number from index is even.</h3>
    <% } else { %>
        <h3>The number from index is odd.</h3>
    <% } %>

    <h3><%= rand%2 === 0 ? 'The number from index is even.' : 'The number from index is odd.' %></h3>
</body>
</html> 