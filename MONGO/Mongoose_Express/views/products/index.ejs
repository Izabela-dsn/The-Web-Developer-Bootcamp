<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Products</title>
</head>

<body>
    <h1>Products</h1>
    <ul>
        <% products.forEach(product=> { %>
            <li>
                <%= product.name %> - $<%= product.price %><br><a href="/products/<%= product._id %>">See Details</a>
            </li>
            <% }) 
        %>
    </ul>

    <br>
    <a href="/products/new">Create New Product</a>
</body>

</html>