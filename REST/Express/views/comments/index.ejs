<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Comments</title>
</head>

<body>
    <h1>Comments</h1>
    <ul>
        <% for(let comment of comments) { %>
            <li>
                <a href="/comments/<%= comment.id %>"><br><b>
                        <%= comment.username %>
                    </b> - <br>
                    <%= comment.comment %>
                </a>
            </li>
            <% } %>
    </ul>
    <a href="/comments/new">Make a new comment</a>
</body>

</html>